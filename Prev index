<!DOCTYPE html>
<html lang="bn">
<head>
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>বিদ্যুৎ বিল হিসাব</title>
<style>
  :root{
    --ink:#1c2321;
    --paper:#f6f3ec;
    --card:#ffffff;
    --line:#e4ddc9;
    --brass:#a8763e;
    --brass-dark:#7d5527;
    --volt:#2f6f4f;
    --volt-soft:#e7f1e9;
    --warn:#b4472a;
    --warn-soft:#f7e6df;
    --muted:#7a7264;
    --shadow: 0 1px 2px rgba(28,35,33,.06), 0 8px 24px -12px rgba(28,35,33,.18);
    --radius: 14px;
    --mono: 'JetBrains Mono', 'Courier New', monospace;
    --serif: 'Source Serif 4', Georgia, 'Noto Serif Bengali', serif;
    --sans: 'Inter', 'Noto Sans Bengali', system-ui, sans-serif;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:
      radial-gradient(1200px 600px at 100% -10%, #efe6cf 0%, transparent 60%),
      var(--paper);
    color:var(--ink);
    font-family:var(--sans);
    min-height:100vh;
    padding-bottom:60px;
  }
  ::selection{background:#d9c9a0;}

  .topbar{
    padding:28px 20px 20px;
    max-width:980px;
    margin:0 auto;
    display:flex;
    align-items:flex-end;
    justify-content:space-between;
    gap:16px;
    flex-wrap:wrap;
    border-bottom:1px solid var(--line);
  }
  .brand{display:flex; align-items:center; gap:12px;}
  .brand-mark{
    width:40px;height:40px;border-radius:10px;
    background:linear-gradient(155deg, var(--brass), var(--brass-dark));
    display:flex;align-items:center;justify-content:center;
    box-shadow: var(--shadow);
    flex-shrink:0;
  }
  .brand-mark svg{width:22px;height:22px;}
  .brand h1{ font-family:var(--serif); font-size:22px; font-weight:600; margin:0; letter-spacing:.2px;}
  .brand p{margin:2px 0 0; font-size:12.5px; color:var(--muted);}
  .month-pill{
    font-family:var(--mono); font-size:13px; background:var(--card);
    border:1px solid var(--line); padding:8px 14px; border-radius:100px;
    color:var(--brass-dark); font-weight:600;
  }

  .wrap{max-width:980px; margin:0 auto; padding:24px 20px 0;}

  .tabs{
    display:flex; gap:6px; margin-bottom:22px;
    background:var(--card); border:1px solid var(--line); border-radius:12px;
    padding:5px; box-shadow:var(--shadow);
  }
  .tab{
    flex:1; text-align:center; padding:10px 8px; border-radius:9px;
    font-size:14px; font-weight:600; cursor:pointer; color:var(--muted);
    transition:.15s; user-select:none;
  }
  .tab.active{background:var(--ink); color:var(--paper);}
  .tab:not(.active):hover{background:var(--volt-soft); color:var(--ink);}

  .view{display:none;}
  .view.active{display:block; animation:fade .25s ease;}
  @keyframes fade{from{opacity:0; transform:translateY(4px);} to{opacity:1; transform:none;}}

  .card{
    background:var(--card); border:1px solid var(--line); border-radius:var(--radius);
    box-shadow:var(--shadow); padding:20px; margin-bottom:18px;
  }
  .card h2{ font-family:var(--serif); font-size:18px; margin:0 0 4px; font-weight:600;}
  .card .sub{font-size:13px; color:var(--muted); margin:0 0 16px;}

  label{font-size:12.5px; font-weight:600; color:var(--muted); display:block; margin-bottom:5px;}
  input, select{
    width:100%; padding:10px 12px; border:1px solid var(--line); border-radius:9px;
    background:#fffdf8; font-size:14px; color:var(--ink); font-family:var(--sans);
  }
  input:focus, select:focus{outline:2px solid var(--brass); outline-offset:1px;}
  input:disabled{color:var(--muted); background:var(--paper);}
  .row{display:flex; gap:10px; flex-wrap:wrap;}
  .row > div{flex:1; min-width:140px;}

  .btn{ display:inline-flex; align-items:center; gap:6px; padding:10px 16px; border-radius:9px;
    border:none; font-weight:600; font-size:13.5px; cursor:pointer; transition:.15s;}
  .btn-primary{background:var(--ink); color:var(--paper);}
  .btn-primary:hover{background:#333c39;}
  .btn-ghost{background:transparent; color:var(--muted); border:1px solid var(--line);}
  .btn-ghost:hover{border-color:var(--brass); color:var(--brass-dark);}
  .btn:disabled{opacity:.4; cursor:not-allowed;}

  .meter-block{ border:1px solid var(--line); border-radius:12px; padding:14px 16px;
    margin-bottom:12px; background:#fffdf9;}
  .meter-head{ display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;}
  .meter-name{ font-family:var(--mono); font-weight:700; font-size:15px; display:flex; align-items:center; gap:8px;}
  .meter-name .tag{ background:var(--volt-soft); color:var(--volt); font-family:var(--sans);
    font-size:11px; font-weight:700; padding:2px 8px; border-radius:100px;}
  .sub-list{display:flex; flex-direction:column; gap:8px;}
  .sub-row{ display:flex; gap:8px; align-items:center; background:var(--paper);
    border:1px solid var(--line); border-radius:8px; padding:7px 9px;}
  .sub-row input{padding:7px 9px; font-size:13.5px;}
  .sub-row .letter{ font-family:var(--mono); font-weight:700; color:var(--brass-dark); width:22px;
    text-align:center; flex-shrink:0;}
  .icon-btn{ background:none; border:none; cursor:pointer; color:var(--muted); padding:4px;
    border-radius:6px; display:flex;}
  .icon-btn:hover{color:var(--warn); background:var(--warn-soft);}
  .add-link{ font-size:13px; font-weight:600; color:var(--volt); cursor:pointer;
    display:inline-flex; align-items:center; gap:5px; margin-top:4px;}
  .add-link:hover{text-decoration:underline;}

  .stat-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-bottom:4px;}
  .stat{ background:#fffdf9; border:1px solid var(--line); border-radius:10px; padding:12px 14px;}
  .stat .k{font-size:11.5px; color:var(--muted); font-weight:600; text-transform:uppercase; letter-spacing:.4px;}
  .stat .v{font-family:var(--mono); font-size:18px; font-weight:700; margin-top:3px;}
  .stat.accent .v{color:var(--brass-dark);}
  .stat.good .v{color:var(--volt);}

  table{width:100%; border-collapse:collapse; margin-top:10px; font-size:13.5px;}
  th{ text-align:left; font-size:11px; text-transform:uppercase; letter-spacing:.4px; color:var(--muted);
    padding:8px 8px; border-bottom:1px solid var(--line);}
  td{padding:9px 8px; border-bottom:1px solid var(--line);}
  tr:last-child td{border-bottom:none;}
  td.num, th.num{text-align:right; font-family:var(--mono);}
  .meter-section-title{ font-family:var(--mono); font-weight:700; font-size:14.5px; display:flex;
    align-items:center; justify-content:space-between; margin-bottom:2px; flex-wrap:wrap; gap:6px;}
  .meter-section-title .charge-note{font-family:var(--sans); font-weight:500; font-size:12px; color:var(--muted);}
  .divider{height:1px; background:var(--line); margin:16px 0;}

  .reading-table input{padding:6px 8px; font-size:13px; text-align:right;}
  .reading-table td{vertical-align:middle;}
  .units-cell{font-family:var(--mono); font-weight:700; text-align:right;}
  .units-cell.faded{color:var(--muted); font-weight:500;}
  .units-cell.warn{color:var(--warn);}
  .auto-tag{display:block; font-size:10px; color:var(--muted); font-weight:500; margin-top:2px;}

  .recon-banner{ padding:10px 14px; border-radius:9px; font-size:13px; font-weight:600;
    margin-top:14px; display:flex; align-items:flex-start; gap:8px; line-height:1.5;}
  .recon-banner.ok{background:var(--volt-soft); color:var(--volt);}
  .recon-banner.warn{background:var(--warn-soft); color:var(--warn);}
  .recon-banner svg{flex-shrink:0; margin-top:1px;}

  .hist-item{ border:1px solid var(--line); border-radius:10px; padding:14px 16px; margin-bottom:10px;
    cursor:pointer; background:#fffdf9; transition:.15s;}
  .hist-item:hover{border-color:var(--brass);}
  .hist-top{display:flex; justify-content:space-between; align-items:center; gap:8px; flex-wrap:wrap;}
  .hist-top-left{display:flex; align-items:center; gap:8px; flex-wrap:wrap;}
  .hist-month{font-family:var(--serif); font-weight:600; font-size:16px;}
  .hist-total{font-family:var(--mono); font-weight:700; color:var(--brass-dark);}
  .hist-meta{font-size:12.5px; color:var(--muted); margin-top:3px;}
  .hist-meta .due-note{color:var(--warn); font-weight:600;}
  .empty{text-align:center; padding:50px 20px; color:var(--muted);}
  .empty svg{width:44px; height:44px; opacity:.4; margin-bottom:10px;}

  .pay-badge{ font-size:11px; font-weight:700; padding:3px 10px; border-radius:100px; white-space:nowrap;}
  .pay-badge.paid{background:var(--volt-soft); color:var(--volt);}
  .pay-badge.unpaid{background:var(--warn-soft); color:var(--warn);}
  .pay-badge.partial{background:#f3e9d2; color:var(--brass-dark);}

  .pay-pill{ border:none; cursor:pointer; font-weight:700; font-size:11.5px; padding:6px 12px;
    border-radius:100px; font-family:var(--sans); transition:.15s; white-space:nowrap;}
  .pay-pill.unpaid{background:var(--card); color:var(--brass-dark); border:1.5px solid var(--brass);}
  .pay-pill.unpaid:hover{background:#f1e6cf;}
  .pay-pill.paid{background:var(--volt); color:#fff; border:1.5px solid var(--volt);}
  .pay-pill.paid:hover{background:#25593f;}
  .pay-date{font-size:10px; color:var(--muted); margin-top:4px;}
  tr.row-paid{background:var(--volt-soft);}
  tr.row-paid td{border-bottom-color:#d3e6da;}

  .arrears-note{font-size:10.5px; color:var(--warn); margin-top:4px; line-height:1.4; max-width:180px;}
  .arrears-note.cleared{color:var(--volt);}
  .due-reminder{ background:#f3e9d2; color:var(--brass-dark); padding:10px 14px; border-radius:9px;
    font-size:12.5px; margin-top:12px; line-height:1.7;}

  .backup-bar{display:flex; gap:8px; justify-content:flex-end; margin-bottom:16px; flex-wrap:wrap;}
  .btn-sm{padding:7px 12px; font-size:12.5px; border-radius:8px;}
  .summary-stats{display:flex; gap:10px; margin:14px 0 18px; flex-wrap:wrap;}
  .summary-stats .stat{flex:1; min-width:100px;}

  .field-note{font-size:12px; color:var(--muted); margin-top:6px; line-height:1.5;}

  .modal-overlay{ position:fixed; inset:0; background:rgba(28,35,33,.45); display:none;
    align-items:center; justify-content:center; padding:20px; z-index:50;}
  .modal-overlay.active{display:flex;}
  .modal{ background:var(--card); border-radius:14px; padding:22px; max-width:520px; width:100%;
    box-shadow:var(--shadow); max-height:85vh; overflow-y:auto;}
  .modal h3{font-family:var(--serif); margin:0 0 4px; font-size:18px;}
  .modal .sub{font-size:13px; color:var(--muted); margin:0 0 16px;}
  .modal-actions{display:flex; gap:8px; justify-content:flex-end; margin-top:18px;}

  .toast{ position:fixed; bottom:24px; left:50%; transform:translateX(-50%) translateY(20px);
    background:var(--ink); color:var(--paper); padding:12px 20px; border-radius:10px;
    font-size:13.5px; font-weight:600; opacity:0; pointer-events:none; transition:.25s;
    z-index:100; box-shadow:var(--shadow); display:flex; align-items:center; gap:8px;}
  .toast.show{opacity:1; transform:translateX(-50%) translateY(0);}

  @media(max-width:560px){
    .stat-grid{grid-template-columns:1fr 1fr;}
    .stat-grid .stat:first-child{grid-column:1/-1;}
    table{font-size:12px;}
    td,th{padding:7px 5px;}
    .reading-table input{padding:5px 6px; font-size:12px;}
  }

  :root{--ink:#0f172a;--paper:#f4f6fb;--card:#fff;--line:#e5e9f2;--brass:#4f46e5;--brass-dark:#3730a3;--volt:#059669;--volt-soft:#ecfdf5;--warn:#dc2626;--warn-soft:#fef2f2;--muted:#64748b;--radius:14px;--shadow:0 1px 2px rgba(15,23,42,.05),0 6px 20px -10px rgba(15,23,42,.12);--sans:'Inter','Hind Siliguri','Noto Sans Bengali',system-ui,sans-serif;--serif:var(--sans);--mono:var(--sans)}
  body{background:var(--paper);font-feature-settings:"tnum"}
  h1,h2,h3,.hist-month{font-family:var(--sans)!important;letter-spacing:-.01em}
  .topbar{max-width:none;margin:0;padding:12px max(20px,calc((100% - 980px)/2));background:#fff;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:20;align-items:center}
  .brand h1{font-size:17px;font-weight:700}.brand-mark{background:linear-gradient(135deg,#6366f1,#4338ca);border-radius:11px;width:36px;height:36px}
  .topbar-right{display:flex;align-items:center;gap:8px}.user-chip{font-size:12.5px;font-weight:600;color:var(--muted)}
  .month-pill{background:#eef2ff;border:none;color:var(--brass-dark);font-size:12.5px}
  .tabs{background:transparent;border:none;box-shadow:none;border-bottom:1px solid var(--line);border-radius:0;padding:0;gap:22px}
  .tab{flex:none;padding:12px 2px;border-radius:0;border-bottom:2px solid transparent;margin-bottom:-1px;background:none!important}
  .tab.active{color:var(--brass-dark);border-bottom-color:var(--brass)}
  .card,.meter-block,.hist-item,.stat{border-radius:var(--radius);box-shadow:var(--shadow)}.stat,.meter-block{box-shadow:none}
  .btn{border-radius:10px}.btn-primary{background:var(--brass)}.btn-primary:hover{background:var(--brass-dark)}
  input,select{border-radius:10px;background:#fff}input:focus,select:focus{outline:2px solid #c7d2fe;border-color:var(--brass)}
  th{background:#f8fafc;font-size:10.5px}td.num,th.num,.stat .v,.hist-total{font-family:var(--sans);font-variant-numeric:tabular-nums}
  .pay-pill.unpaid{border-color:#f59e0b;color:#b45309;background:#fffbeb}.pay-pill.paid{background:var(--volt);border-color:var(--volt)}
  .paid-on{display:inline-flex;align-items:center;gap:4px;margin-top:6px;font-size:11px;font-weight:600;color:var(--volt);background:#d1fae5;padding:3px 8px;border-radius:6px;white-space:nowrap}
  tr.row-paid{background:#f0fdf4}.due-reminder{background:#fffbeb;color:#92400e;border:1px solid #fde68a}
  body.locked .topbar,body.locked .wrap{display:none}
  .login-overlay{position:fixed;inset:0;z-index:100;display:flex;background:linear-gradient(135deg,#eef2ff,#f4f6fb 55%,#ecfdf5);overflow:auto}
  .login-side{flex:1;padding:56px;display:flex;flex-direction:column;justify-content:center;max-width:520px;margin-left:auto}
  .login-side h2{font-size:30px;line-height:1.25;margin:18px 0 10px;font-weight:800}.login-side p{color:var(--muted);line-height:1.7;margin:0 0 18px}
  .login-side li{list-style:none;padding:8px 0 8px 28px;position:relative;font-size:14px;color:#334155}.login-side ul{margin:0;padding:0}
  .login-side li:before{content:"✓";position:absolute;left:0;color:var(--volt);font-weight:800}
  .login-box{flex:1;max-width:460px;margin:auto 40px auto 0;background:#fff;border:1px solid var(--line);border-radius:18px;padding:30px;box-shadow:0 20px 50px -20px rgba(15,23,42,.25)}
  .login-box h3{margin:0 0 4px;font-size:20px}.login-box .hint{color:var(--muted);font-size:13px;margin:0 0 14px}.login-box label{margin-top:12px}
  .login-err{color:var(--warn);font-size:12.5px;margin-top:10px;min-height:16px}.login-foot{font-size:11.5px;color:var(--muted);margin-top:14px;line-height:1.6}
  @media(max-width:820px){.login-overlay{flex-direction:column}.login-side{padding:28px 22px 6px;max-width:none}.login-side h2{font-size:23px}.login-box{margin:16px;max-width:none}.tabs{gap:14px;overflow-x:auto}}
</style>
</head>
<body class="locked">
<div class="login-overlay" id="loginOverlay">
  <div class="login-side"><div class="brand"><div class="brand-mark"><svg viewBox="0 0 24 24" fill="none"><path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z" fill="#fff"/></svg></div><h1>বিদ্যুৎ বিল হিসাব</h1></div>
    <h2>বাড়িভাড়ার বিদ্যুৎ বিল, এক জায়গায় পরিষ্কার হিসাব</h2><p>মেইন মিটারের বিল থেকে প্রতিটি সাব-মিটার হোল্ডারের ভাগ নিজে নিজেই হিসাব হয়ে যায়।</p>
    <ul><li>রিডিং দিলেই ইউনিট ও প্রতি ইউনিটের রেট বের হয়</li><li>বকেয়া পরের মাসের বিলে অটো যোগ হয়</li><li>কবে পরিশোধ হলো তার তারিখসহ পূর্ণ হিস্ট্রি</li><li>ডেটা এই ব্রাউজারে সেভ থাকে; হিস্ট্রি ট্যাব থেকে ব্যাকআপ নেওয়া যায়</li></ul></div>
  <div class="login-box">
    <div id="loginForm"><h3>লগইন</h3><p class="hint">Username ও PIN দিয়ে প্রবেশ করুন</p>
      <label>Username</label><input id="lgUser" autocomplete="username"><label>PIN</label><input id="lgPin" type="password" inputmode="numeric" maxlength="8" autocomplete="current-password" onkeydown="if(event.key==='Enter')loginUser()">
      <button class="btn btn-primary" style="width:100%;margin-top:16px;justify-content:center" onclick="loginUser()">লগইন</button>
      <button class="btn btn-ghost" style="width:100%;margin-top:8px;justify-content:center" onclick="toggleAuth(true)">নতুন অ্যাকাউন্ট</button></div>
    <div id="regForm" style="display:none"><h3>নতুন অ্যাকাউন্ট</h3><p class="hint">Username ও ৪–৮ সংখ্যার PIN সেট করুন</p>
      <label>Username</label><input id="rgUser" autocomplete="username"><label>PIN</label><input id="rgPin" type="password" inputmode="numeric" maxlength="8"><label>PIN আবার</label><input id="rgPin2" type="password" inputmode="numeric" maxlength="8">
      <button class="btn btn-primary" style="width:100%;margin-top:16px;justify-content:center" onclick="registerUser()">তৈরি করুন</button>
      <button class="btn btn-ghost" style="width:100%;margin-top:8px;justify-content:center" onclick="toggleAuth(false)">লগইনে ফিরুন</button></div>
    <div class="login-err" id="loginErr"></div>
  </div>
</div>


<header class="topbar"><div class="brand"><div class="brand-mark"><svg viewBox="0 0 24 24" fill="none"><path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z" fill="#fff"/></svg></div><h1>বিদ্যুৎ বিল হিসাব</h1></div><div class="topbar-right"><span class="month-pill" id="currentMonthPill">—</span><span class="user-chip" id="userChip"></span><button class="btn btn-ghost btn-sm" onclick="logoutUser()">লগআউট</button></div></header>
<div class="wrap">

  <div class="tabs">
    <div class="tab active" data-view="setup">মিটার সেটআপ</div>
    <div class="tab" data-view="calc">এই মাসের হিসাব</div>
    <div class="tab" data-view="history">হিস্ট্রি</div>
  </div>

  <!-- SETUP VIEW -->
  <div class="view active" id="view-setup">
    <div class="card">
      <h2>মেইন মিটার যোগ করুন</h2>
      <div class="row">
        <div style="flex:2;">
          <label for="newMeterName">মিটারের নাম</label>
          <input type="text" id="newMeterName" placeholder="যেমনঃ 2B, 3A">
        </div>
        <div style="flex:1; align-self:flex-end;">
          <button class="btn btn-primary" style="width:100%;" onclick="addMeter()">+ মিটার যোগ</button>
        </div>
      </div>
    </div>

    <div id="metersContainer"></div>

    <div class="empty" id="setupEmpty" style="display:none;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z"/></svg>
      <p>এখনো কোনো মিটার যোগ করা হয়নি। উপরে থেকে প্রথম মিটার যোগ করুন।</p>
    </div>
  </div>

  <!-- CALC VIEW -->
  <div class="view" id="view-calc">
    <div class="card">
      <h2>মাস নির্বাচন করুন</h2>
      <div class="row">
        <div>
