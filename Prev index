async function hp(x){try{const b=await crypto.subtle.digest('SHA-256',new TextEncoder().encode('bh:'+x));return [...new Uint8Array(b)].map(v=>v.toString(16).padStart(2,'0')).join('')}catch(e){let h=5381;for(const c of 'bh:'+x)h=((h<<5)+h+c.charCodeAt(0))|0;return 'f'+h}}
function toggleAuth(reg){document.getElementById('loginForm').style.display=reg?'none':'block';document.getElementById('regForm').style.display=reg?'block':'none';authErr('')}
