      subList.appendChild(row);
    });
  });
}

/* ---------------- CORE CALCULATION (shared by live view + save) ---------------- */
function distributeWithRounding(rawValues, target){
  if(rawValues.length===0) return [];
  const t = Math.round((parseFloat(target)||0)*100)/100;
  let rounded = rawValues.map(v=>Math.round(v*100)/100);
  if(rawValues.length===1){ rounded[0]=t; return rounded; }
  const sumExceptLast = rounded.slice(0,-1).reduce((a,b)=>a+b,0);
  rounded[rounded.length-1] = Math.round((t - sumExceptLast)*100)/100;
  return rounded;
}

// subsReadings: { subId: {prev, curr} } (strings or numbers, possibly blank)
function computeMeterBreakdown(meter, totalBillRaw, meterChargeRaw, subsReadings){
  const totalBill = parseFloat(totalBillRaw) || 0;
  const meterCharge = parseFloat(meterChargeRaw) || 0;
  const subCount = meter.subs.length;
  const remaining = totalBill - (meterCharge * subCount); // প্রতিটা সাব-মিটার পুরো মিটার চার্জটাই দেয় (ভাগ হয় না), তাই মোট বিল থেকে (মিটার চার্জ × সাব-মিটার সংখ্যা) বাদ যায়
  const equalShare = meterCharge; // প্রতিটা সাব-মিটার হোল্ডার এই পুরো মিটার চার্জটাই দেয় — ভাগ হয় না, সবার জন্য সমান

  let totalUnits = 0;
  const subsResult = meter.subs.map(sub=>{
    const r = subsReadings[sub.id] || {};
    const prev = (r.prev!==undefined && r.prev!=='' && r.prev!==null) ? parseFloat(r.prev) : null;
    const curr = (r.curr!==undefined && r.curr!=='' && r.curr!==null) ? parseFloat(r.curr) : null;
    let units = 0, warning = null;
    if(prev!==null && curr!==null){
      units = curr - prev;
      if(units < 0){ warning = 'negative'; units = 0; }
    } else if(curr!==null && prev===null){
      warning = 'missing-prev';
    }
    totalUnits += units;
    return { id:sub.id, label:sub.label, name:sub.name, prev, curr, units, warning };
  });

  const perUnitRate = totalUnits>0 ? remaining/totalUnits : 0;
  subsResult.forEach(s=>{
    s.usageCostRaw = s.units*perUnitRate;
    s.totalRaw = equalShare + s.usageCostRaw;
  });

  let reconciled = false;
  if(subCount>0){
    if(totalUnits>0){
      const finalTotals = distributeWithRounding(subsResult.map(s=>s.totalRaw), totalBill);
      const roundedEqual = Math.round(equalShare*100)/100;
      subsResult.forEach((s,i)=>{ s.total = finalTotals[i]; s.usageCost = Math.round((s.total - roundedEqual)*100)/100; });
      reconciled = true;
    } else {
      subsResult.forEach(s=>{ s.total = Math.round(equalShare*100)/100; s.usageCost = 0; });
      reconciled = Math.abs(remaining) < 0.005;
    }
  }
  const distributedSum = subsResult.reduce((a,s)=>a+(s.total||0),0);

  return { totalBill, meterCharge, remaining, subCount, equalShare, totalUnits, perUnitRate, subsResult, distributedSum, reconciled };
}

// Sum of unpaid earlier months (strictly before `beforeYm`) for one sub-meter,
// so an unpaid January shows up as arrears once February's bill exists.
function getArrearsForSub(meterId, subId, beforeYm){
  const history = loadHistory().filter(h=>h.ym < beforeYm).sort((a,b)=> a.ym < b.ym ? -1 : 1);
  const months = [];
  let total = 0;
  history.forEach(h=>{
    const m = h.meters.find(mm=>mm.id===meterId);
    if(!m) return;
    const s = m.subs.find(ss=>ss.id===subId);
    if(!s) return;
    if(!s.paid){ months.push({ ym:h.ym, amount:s.total }); total += s.total; }
  });
  return { total, months };
}

function getPrevReadingFromHistory(meterId, subId, ym){
  const history = loadHistory().filter(h=>h.ym < ym).sort((a,b)=> a.ym < b.ym ? 1 : -1);
  for(const rec of history){
    const m = rec.meters.find(mm=>mm.id===meterId);
    if(m){
      const s = m.subs.find(ss=>ss.id===subId);
      if(s && s.curr!==null && s.curr!==undefined) return s.curr;
    }
  }
  return null;
}

/* ---------------- CALC VIEW ---------------- */
function loadDraftForMonth(){ renderCalcView(); }

function getDraftForMonth(ym){
  const drafts = loadDrafts();
  return drafts[ym] || {};
}

function renderCalcView(){
  const container = document.getElementById('calcMetersContainer');
  const empty = document.getElementById('calcEmpty');
  const saveBar = document.getElementById('saveBar');
  container.innerHTML = '';

  if(meters.length === 0){ empty.style.display='block'; saveBar.style.display='none'; return; }
  empty.style.display='none';
  saveBar.style.display='block';

  const ym = calcMonthInput.value;
  const draftData = getDraftForMonth(ym);

  meters.forEach(meter=>{
    const md = draftData[meter.id] || {};
    const subsDraft = md.subs || {};

    const card = document.createElement('div');
    card.className = 'card meter-section';

    let readingRows = '';
    meter.subs.forEach(sub=>{
      const d = subsDraft[sub.id] || {};
      let prevVal = d.prev;
      let autoFilled = false;
      if(prevVal === undefined || prevVal === '' || prevVal === null){
        const hist = getPrevReadingFromHistory(meter.id, sub.id, ym);
        if(hist !== null){ prevVal = hist; autoFilled = true; } else { prevVal = ''; }
      }
      const currVal = (d.curr!==undefined && d.curr!==null) ? d.curr : '';
      readingRows += `
        <tr>
          <td><span style="font-family:var(--mono); font-weight:700; color:var(--brass-dark);">${sub.label}</span>${sub.name ? ' — '+escapeHtml(sub.name) : ''}</td>
          <td style="width:110px;">
            <input type="number" step="0.01" class="prevInput" data-meter="${meter.id}" data-sub="${sub.id}" value="${prevVal}" placeholder="আগের">
            ${autoFilled ? '<span class="auto-tag">গত মাসের রিডিং</span>' : ''}
          </td>
          <td style="width:110px;">
            <input type="number" step="0.01" class="currInput" data-meter="${meter.id}" data-sub="${sub.id}" value="${currVal}" placeholder="বর্তমান">
          </td>
          <td class="units-cell" id="units-${meter.id}-${sub.id}" style="width:70px;">—</td>
        </tr>`;
    });

    card.innerHTML = `
      <div class="meter-section-title">
        <span>মিটার: ${escapeHtml(meter.name)}</span>
        <span class="charge-note">${meter.subs.length}টি সাব-মিটার</span>
      </div>
      <div class="divider"></div>
      <div class="row">
        <div>
          <label>মোট বিল (টাকা)</label>
          <input type="number" min="0" step="0.01" class="totalBillInput" data-meter="${meter.id}" value="${md.totalBill ?? ''}" placeholder="যেমনঃ 5600">
        </div>
        <div>
          <label>মিটার চার্জ / ডিমান্ড চার্জ (টাকা)</label>
          <input type="number" min="0" step="0.01" class="meterChargeInput" data-meter="${meter.id}" value="${md.meterCharge ?? ''}" placeholder="যেমনঃ 500">
        </div>
      </div>

      ${meter.subs.length > 0 ? `
      <div class="divider"></div>
      <table class="reading-table">
        <thead><tr><th>সাব-মিটার</th><th>আগের রিডিং</th><th>বর্তমান রিডিং</th><th class="num">ইউনিট</th></tr></thead>
        <tbody>${readingRows}</tbody>
      </table>
      ` : `<p class="field-note">এই মিটারের নিচে কোনো সাব-মিটার নেই। আগে "মিটার সেটআপ"-এ গিয়ে যোগ করুন।</p>`}

      <div id="resultTable-${meter.id}"></div>
    `;
    container.appendChild(card);

    card.querySelectorAll('.totalBillInput, .meterChargeInput, .prevInput, .currInput').forEach(inp=>{
      inp.addEventListener('input', ()=>{ autoSaveDraft(); computeAndRenderMeter(meter); });
    });

    computeAndRenderMeter(meter);
  });
}

function readMeterInputsFromDOM(meter){
  const totalBillInput = document.querySelector(`.totalBillInput[data-meter="${meter.id}"]`);
  const meterChargeInput = document.querySelector(`.meterChargeInput[data-meter="${meter.id}"]`);
  const subsReadings = {};
  meter.subs.forEach(sub=>{
    const prevInput = document.querySelector(`.prevInput[data-meter="${meter.id}"][data-sub="${sub.id}"]`);
    const currInput = document.querySelector(`.currInput[data-meter="${meter.id}"][data-sub="${sub.id}"]`);
    subsReadings[sub.id] = { prev: prevInput ? prevInput.value : '', curr: currInput ? currInput.value : '' };
  });
  return {
    totalBill: totalBillInput ? totalBillInput.value : '',
    meterCharge: meterChargeInput ? meterChargeInput.value : '',
    subsReadings
  };
}

function autoSaveDraft(){
  const ym = calcMonthInput.value;
  const drafts = loadDrafts();
  const data = {};
  meters.forEach(meter=>{
    const { totalBill, meterCharge, subsReadings } = readMeterInputsFromDOM(meter);
    data[meter.id] = { totalBill, meterCharge, subs: subsReadings };
  });
  drafts[ym] = data;
  saveDrafts(drafts);
}

function computeAndRenderMeter(meter){
  const resultDiv = document.getElementById(`resultTable-${meter.id}`);
  if(!resultDiv) return;

  const { totalBill, meterCharge, subsReadings } = readMeterInputsFromDOM(meter);
  const result = computeMeterBreakdown(meter, totalBill, meterCharge, subsReadings);

  result.subsResult.forEach(s=>{
    const cell = document.getElementById(`units-${meter.id}-${s.id}`);
    if(!cell) return;
    cell.classList.remove('faded','warn');
    if(s.warning === 'negative'){
      cell.textContent = '০ ⚠';
      cell.classList.add('warn');
      cell.title = 'বর্তমান রিডিং আগের রিডিংয়ের চেয়ে কম — চেক করুন';
    } else if(s.prev===null || s.curr===null){
      cell.textContent = '—';
      cell.classList.add('faded');
      cell.title = s.warning==='missing-prev' ? 'আগের রিডিং দিন' : 'রিডিং দিন';
    } else {
      cell.textContent = s.units.toFixed(2);
    }
  });

  if(meter.subs.length === 0){ resultDiv.innerHTML=''; return; }

  const ym = calcMonthInput.value;
  let rows = '';
  result.subsResult.forEach(s=>{
    rows += `<tr>
      <td><span style="font-family:var(--mono); font-weight:700; color:var(--brass-dark);">${s.label}</span>${s.name?' — '+escapeHtml(s.name):''}</td>
      <td class="num">${(s.prev!==null && s.curr!==null) ? s.units.toFixed(2) : '—'}</td>
      <td class="num">৳${(Math.round(result.equalShare*100)/100).toFixed(2)}</td>
      <td class="num">৳${(s.usageCost||0).toFixed(2)}</td>
      <td class="num" style="font-weight:700;">৳${(s.total||0).toFixed(2)}</td>
    </tr>`;
  });

  // Outstanding-dues reminder: look at each sub's SAVED history strictly before this
  // month and flag anyone who still owes from an earlier month, so the arrear is
  // visible while this month's bill is being prepared (actual paid/unpaid tracking
  // and the "pay clears arrears too" action live in the History tab).
  let arrearsNotes = [];
  meter.subs.forEach(sub=>{
    const ar = getArrearsForSub(meter.id, sub.id, ym);
    if(ar.total > 0.005){
      arrearsNotes.push(`<b>${sub.label}${sub.name?' ('+escapeHtml(sub.name)+')':''}</b>: ৳${ar.total.toFixed(2)} বাকি (${ar.months.map(m=>formatMonthLabel(m.ym)).join(', ')})`);
    }
  });
  const arrearsBanner = arrearsNotes.length ? `<div class="due-reminder">⏳ পূর্বের বকেয়া — এই মাসের বিলের সাথে এগুলোও আদায় করতে হবে:<br>${arrearsNotes.join('<br>')}</div>` : '';

  let banner = '';
  if(result.remaining < -0.005){
    banner = `<div class="recon-banner warn"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v4M12 17h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>মিটার চার্জ মোট বিলের চেয়ে বেশি হয়ে গেছে — সংখ্যা দুটো আবার চেক করুন।</div>`;
  } else if(result.totalUnits === 0 && Math.abs(result.remaining) > 0.005){
    banner = `<div class="recon-banner warn"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v4M12 17h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>ইউনিট রিডিং দেওয়া হয়নি বলে ৳${result.remaining.toFixed(2)} টাকা এখনো ভাগ করা যায়নি — উপরে প্রতিটা সাব-মিটারের রিডিং দিন।</div>`;
  } else if(result.reconciled && meter.subs.length>0){
    banner = `<div class="recon-banner ok"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>হিসাব মিলে গেছে — সাব-মিটারগুলোর সর্বমোট ৳${result.distributedSum.toFixed(2)} = মেইন বিল ৳${result.totalBill.toFixed(2)}</div>`;
  }

  resultDiv.innerHTML = `
    <div class="divider"></div>
    <div class="stat-grid">
      <div class="stat accent"><div class="k">মোট ইউনিট ব্যবহার</div><div class="v">${result.totalUnits.toFixed(2)}</div></div>
      <div class="stat"><div class="k">প্রতি ইউনিট রেট</div><div class="v">৳${result.perUnitRate.toFixed(3)}</div></div>
      <div class="stat good"><div class="k">সাব-মিটার প্রতি চার্জ</div><div class="v">৳${(Math.round(result.equalShare*100)/100).toFixed(2)}</div></div>
    </div>
    <table>
      <thead><tr><th>সাব-মিটার</th><th class="num">ইউনিট</th><th class="num">মিটার চার্জ</th><th class="num">ব্যবহার খরচ</th><th class="num">সর্বমোট</th></tr></thead>
      <tbody>${rows}</tbody>
    </table>
    ${banner}
    ${arrearsBanner}
  `;
}

/* ---------------- SAVE MONTH TO HISTORY ---------------- */
function saveMonth(){
  const ym = calcMonthInput.value;
  if(!ym){ toast('মাস নির্বাচন করুন'); return; }
  autoSaveDraft();

  const drafts = loadDrafts();
  const draftData = drafts[ym] || {};
  let history = loadHistory();
  const existingRecord = history.find(h=>h.ym === ym) || null; // capture BEFORE overwrite, to preserve paid status

  const record = { ym, savedAt: new Date().toISOString(), meters: [] };
  let grandTotal = 0;

  meters.forEach(meter=>{
    const md = draftData[meter.id] || {};
    const result = computeMeterBreakdown(meter, md.totalBill, md.meterCharge, md.subs || {});
    grandTotal += result.totalBill;

    const existingMeter = existingRecord ? existingRecord.meters.find(m=>m.id===meter.id) : null;
    const subsWithPaid = result.subsResult.map(s=>{
      const existingSub = existingMeter ? existingMeter.subs.find(es=>es.id===s.id) : null;
      return { ...s, paid: existingSub ? !!existingSub.paid : false, paidAt: existingSub ? (existingSub.paidAt || null) : null };
    });

    record.meters.push({
      id: meter.id, name: meter.name,
      totalBill: result.totalBill, meterCharge: result.meterCharge, remaining: result.remaining,
      totalUnits: result.totalUnits, perUnitRate: result.perUnitRate, equalShare: result.equalShare,
      subs: subsWithPaid
    });
  });

  record.grandTotal = grandTotal;

  history = history.filter(h=>h.ym !== ym);
  history.unshift(record);
  saveHistory(history);

  toast('✓ ' + formatMonthLabel(ym) + ' মাসের হিসাব সেভ হয়েছে');
  renderHistoryView();
  renderCalcView();
}

/* ---------------- PAYMENT TRACKING (with arrears cascade) ---------------- */
function togglePaid(ym, meterId, subId){
  const history = loadHistory();
  const rec = history.find(h=>h.ym===ym);
  if(!rec) return;
  const m = rec.meters.find(mm=>mm.id===meterId);
  if(!m) return;
  const s = m.subs.find(ss=>ss.id===subId);
  if(!s) return;

  if(s.paid){
    // Undo — only unmarks THIS month; earlier months that were cleared alongside it
    // (if any) stay paid, since that money was genuinely received.
    if(!confirm('এই মাসটিকে আবার "বাকি" হিসেবে চিহ্নিত করতে চান?')) return;
    s.paid = false;
    s.paidAt = null;
    s.settledArrears = null;
    saveHistory(history);
    renderHistoryView();
    openDetailModal(rec);
    toast('বাকি হিসেবে ফিরিয়ে নেওয়া হলো');
    return;
  }

  // Marking paid: pull in any still-unpaid EARLIER months for this same sub-meter,
  // since paying the current bill logically clears the running arrears first.
  const arrears = getArrearsForSub(meterId, subId, ym); // months strictly before `ym`, unpaid
  const thisAmount = s.total;
  const grandTotal = arrears.total + thisAmount;

  if(arrears.months.length > 0){
    const list = arrears.months.map(a=>`${formatMonthLabel(a.ym)} ৳${a.amount.toFixed(2)}`).join(', ');
    const ok = confirm(
      `এই সাব-মিটারের আগের বকেয়া আছে: ${list} (মোট ৳${arrears.total.toFixed(2)})।\n` +
      `${formatMonthLabel(ym)}-এর বিল ৳${thisAmount.toFixed(2)} সহ সব মিলিয়ে ৳${grandTotal.toFixed(2)} পরিশোধিত হিসেবে চিহ্নিত করা হবে। এগোতে চান?`
    );
    if(!ok) return;
  }

  const now = new Date().toISOString();
  history.forEach(h=>{
    if(h.ym >= ym) return; // only touch strictly earlier months here
    const mm = h.meters.find(x=>x.id===meterId); if(!mm) return;
    const ss = mm.subs.find(x=>x.id===subId); if(!ss) return;
    if(!ss.paid){ ss.paid = true; ss.paidAt = now; }
  });
  s.paid = true;
  s.paidAt = now;
  s.settledArrears = arrears.months.length ? arrears.months : null;

  saveHistory(history);
  renderHistoryView();
  const freshRec = loadHistory().find(h=>h.ym===ym);
  if(freshRec) openDetailModal(freshRec);
  toast(arrears.months.length
    ? `✓ ৳${grandTotal.toFixed(2)} পরিশোধিত (এই মাস + ${arrears.months.length}টি আগের বকেয়া)`
    : '✓ পরিশোধিত হিসেবে চিহ্নিত হলো');
}

/* ---------------- BACKUP / RESTORE ---------------- */
function exportBackup(){
  const payload = {
    app: 'bidyut-bill-hisab', exportedAt: new Date().toISOString(),
    meters: loadMeters(), history: loadHistory(), drafts: loadDrafts()
  };
  const blob = new Blob([JSON.stringify(payload, null, 2)], {type:'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `bidyut-bill-backup-${new Date().toISOString().slice(0,10)}.json`;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
  toast('ব্যাকআপ ডাউনলোড হয়েছে');
}

function importBackup(file){
  if(!file) return;
  const reader = new FileReader();
  reader.onload = (e)=>{
    try{
      const data = JSON.parse(e.target.result);
      if(!data || !Array.isArray(data.meters) || !Array.isArray(data.history)){
        toast('এটা সঠিক ব্যাকআপ ফাইল না'); return;
      }
      if(!confirm('এই ব্যাকআপ রিস্টোর করলে বর্তমান সব ডেটা প্রতিস্থাপিত হয়ে যাবে। এগোতে চান?')) return;
      saveMeters(data.meters);
      saveHistory(data.history);
      saveDrafts(data.drafts || {});
      meters = data.meters;
      renderSetupView();
      renderCalcView();
      renderHistoryView();
      toast('✓ ব্যাকআপ থেকে রিস্টোর হয়েছে');
    }catch(err){
      toast('ফাইলটা পড়া যায়নি, ঠিক জেসন ফাইল দিন');
    }
  };
  reader.readAsText(file);
  document.getElementById('importFile').value = '';
}

/* ---------------- HISTORY VIEW ---------------- */
function renderHistoryView(){
  const container = document.getElementById('historyContainer');
  const empty = document.getElementById('historyEmpty');
  const history = loadHistory();
  container.innerHTML = '';
  if(history.length === 0){ empty.style.display='block'; return; }
  empty.style.display='none';

  history.forEach(rec=>{
    const item = document.createElement('div');
    item.className = 'hist-item';
    const meterCount = rec.meters.length;
    const subCount = rec.meters.reduce((a,m)=>a+m.subs.length,0);
    const paidCount = rec.meters.reduce((a,m)=>a+m.subs.filter(s=>s.paid).length,0);
    const dueAmount = rec.meters.reduce((a,m)=>a+m.subs.filter(s=>!s.paid).reduce((x,s)=>x+s.total+getArrearsForSub(m.id,s.id,rec.ym).total,0),0);

    let badge = '';
    if(subCount>0){
      if(paidCount===subCount) badge = `<span class="pay-badge paid">সব পরিশোধিত ✓</span>`;
      else if(paidCount===0) badge = `<span class="pay-badge unpaid">সব বাকি</span>`;
      else badge = `<span class="pay-badge partial">${paidCount}/${subCount} পরিশোধিত</span>`;
    }

    item.innerHTML = `
      <div class="hist-top">
        <div class="hist-top-left">
          <div class="hist-month">${formatMonthLabel(rec.ym)}</div>
          ${badge}
        </div>
        <div class="hist-total">৳${rec.grandTotal.toFixed(2)}</div>
      </div>
      <div class="hist-meta">${meterCount} মেইন মিটার · ${subCount} সাব-মিটার · সেভ: ${new Date(rec.savedAt).toLocaleDateString('bn-BD')}${dueAmount>0.005 ? ` · <span class="due-note">সর্বমোট বাকি ৳${dueAmount.toFixed(2)}</span>`:''}</div>
    `;
    item.addEventListener('click', ()=> openDetailModal(rec));
    container.appendChild(item);
  });
}

function openDetailModal(rec){
  const content = document.getElementById('detailModalContent');

  let paidAmount = 0, dueAmount = 0;
  rec.meters.forEach(m=> m.subs.forEach(s=>{
    if(s.paid){ paidAmount += s.total; }
    else { dueAmount += s.total + getArrearsForSub(m.id, s.id, rec.ym).total; }
  }));

  let html = `<h3>${formatMonthLabel(rec.ym)}</h3><p class="sub">সর্বমোট বিল ৳${rec.grandTotal.toFixed(2)}</p>
    <div class="summary-stats">
      <div class="stat"><div class="k">মোট বিল</div><div class="v">৳${rec.grandTotal.toFixed(2)}</div></div>
      <div class="stat good"><div class="k">সংগ্রহ হয়েছে</div><div class="v">৳${paidAmount.toFixed(2)}</div></div>
      <div class="stat accent"><div class="k">বাকি আছে</div><div class="v">৳${dueAmount.toFixed(2)}</div></div>
    </div>`;

  rec.meters.forEach(m=>{
    html += `<div style="margin-bottom:18px;">
      <div class="meter-section-title" style="margin-bottom:8px;">
        <span>${escapeHtml(m.name)}</span>
        <span class="charge-note">রেট ৳${m.perUnitRate.toFixed(3)}/ইউনিট · চার্জ ৳${m.meterCharge.toFixed(2)}</span>
      </div>
      <table>
        <thead><tr><th>সাব</th><th class="num">আগের</th><th class="num">বর্তমান</th><th class="num">ইউনিট</th><th class="num">সর্বমোট</th><th class="num">স্ট্যাটাস</th></tr></thead>
        <tbody>
        ${m.subs.map(s=>{
          const arrears = s.paid ? {total:0, months:[]} : getArrearsForSub(m.id, s.id, rec.ym);
          const dueTotal = s.paid ? 0 : (s.total + arrears.total);
          return `<tr class="${s.paid ? 'row-paid' : ''}">
          <td><span style="font-family:var(--mono); font-weight:700; color:var(--brass-dark);">${s.label}</span>${s.name?' — '+escapeHtml(s.name):''}</td>
          <td class="num">${s.prev!==null?s.prev.toFixed(2):'—'}</td>
          <td class="num">${s.curr!==null?s.curr.toFixed(2):'—'}</td>
          <td class="num">${s.units.toFixed(2)}</td>
          <td class="num" style="font-weight:700;">৳${s.total.toFixed(2)}</td>
          <td class="num">
            <button class="pay-pill ${s.paid?'paid':'unpaid'}" onclick="togglePaid('${rec.ym}','${m.id}','${s.id}')">${s.paid ? '✓ পরিশোধিত' : (arrears.total>0.005 ? `৳${dueTotal.toFixed(2)} বাকি` : 'বাকি')}</button>
            ${s.paid && s.paidAt ? `<div class="paid-on">✓ পরিশোধ: ${fmtDate(s.paidAt)}</div>` : ''}
            ${s.paid && s.settledArrears && s.settledArrears.length ? `<div class="arrears-note cleared">+ ${s.settledArrears.map(a=>formatMonthLabel(a.ym)).join(', ')}-এর বকেয়াও এর সাথে সাফ হয়েছে</div>` : ''}
            ${!s.paid && arrears.total>0.005 ? `<div class="arrears-note">এই মাস ৳${s.total.toFixed(2)} + পূর্বের ৳${arrears.total.toFixed(2)} (${arrears.months.map(a=>formatMonthLabel(a.ym)).join(', ')})</div>` : ''}
          </td>
        </tr>`;}).join('')}
        </tbody>
      </table>
    </div>`;
  });

  content.innerHTML = html;
  document.getElementById('detailModal').classList.add('active');
}
function closeDetailModal(){ document.getElementById('detailModal').classList.remove('active'); }
document.getElementById('detailModal').addEventListener('click', (e)=>{ if(e.target.id === 'detailModal') closeDetailModal(); });

/* ---------------- INIT ---------------- */
if(currentUser&&accs()[currentUser])enterApp();
</script>
