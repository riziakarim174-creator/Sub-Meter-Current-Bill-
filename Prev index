function nextSubLetter(meter){
  const used = meter.subs.map(s=>s.label);
  const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  for(const l of letters){ if(!used.includes(l)) return l; }
  return String(meter.subs.length + 1);
}
