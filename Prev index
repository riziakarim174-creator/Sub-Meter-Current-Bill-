    container.appendChild(block);
    const subList = block.querySelector(`#subs-${meter.id}`);
    if(meter.subs.length === 0){
      subList.innerHTML = `<p class="field-note" style="margin:0;">কোনো সাব-মিটার নেই।</p>`;
    }
    meter.subs.forEach(sub=>{
      const row = document.createElement('div');
      row.className = 'sub-row';
      row.innerHTML = `
        <span class="letter">${sub.label}</span>
        <input type="text" placeholder="ভাড়াটিয়া / ফ্ল্যাটের নাম (ঐচ্ছিক)" value="${escapeHtml(sub.name)}" onchange="updateSubName('${meter.id}','${sub.id}', this.value)">
        <button class="icon-btn" title="ডিলিট" onclick="deleteSub('${meter.id}','${sub.id}')">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
